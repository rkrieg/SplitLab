# ============================================================
# SplitLab Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- App Config ----
# The hostname of this app (used to detect custom client domains in middleware)
APP_HOSTNAME=splitlab.agency

# The public URL of this app (used for tracking snippet injection)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Storage ----
# Storage provider: 'supabase' (default) or 's3'
STORAGE_PROVIDER=supabase

# Supabase Storage bucket name for HTML pages
SUPABASE_STORAGE_BUCKET=pages

# AWS S3 (optional — only required if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ---- Vercel Domain API ----
# Required for custom domain management
# Get your token from https://vercel.com/account/tokens
VERCEL_API_TOKEN=your-vercel-api-token
# Find in Vercel project settings > General > Project ID
VERCEL_PROJECT_ID=your-vercel-project-id

# ---- Email (Resend) ----
RESEND_API_KEY=re_...

# ---- Admin Bootstrap ----
# Used to create the first admin user on first boot
BOOTSTRAP_ADMIN_EMAIL=admin@youragency.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123!
BOOTSTRAP_ADMIN_NAME=Agency Admin


#-------------------------------------------------------------------------------------#

# ---- AI page builder ----
# Which provider askAI() (src/lib/ai-client.ts) talks to. Default is
# "anthropic" — leave unset for normal production use. Set to anything else
# (e.g. "openai-compatible") to route through an OpenAI-compatible endpoint
# instead — ANY backend that speaks the OpenAI wire format works here:
# Gemini, Groq, Together, OpenRouter, OpenAI's own API, or a local model via
# Ollama/vLLM. Swapping providers is a .env change only; no code changes.
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic (the default)
ANTHROPIC_API_KEY=sk-ant-...
# Optional — defaults to claude-sonnet-4-6 if unset
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required for every non-anthropic backend EXCEPT OpenAI's own API — each one
# lives at a different URL, and only the `openai` npm package's own default
# (https://api.openai.com/v1) is built in. Examples:
#   Local Ollama : http://localhost:11434/v1
#   Gemini       : https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq         : https://api.groq.com/openai/v1
#   Together.ai  : https://api.together.ai/v1
# Leave blank only when using OpenAI's own API.
AI_BASE_URL=http://127.0.0.1:11434/v1
# Local providers like Ollama ignore this — any non-empty string works.
# Every hosted provider (OpenAI's own API, Gemini, Groq, Together, OpenRouter, etc.) needs a real key.
AI_API_KEY=ollama
# The exact model name as that provider expects it
# (e.g. "llama3.2:1b" for Ollama, "gemini-3.5-flash" for Gemini, "gpt-5" for OpenAI's own API)
AI_MODEL=llama3.2:1b
# ---- Asset sources (Drive folder / link → images) ----
# Lets the AI builder list the images inside a PUBLIC Google Drive folder or
# shared file that a user pastes, instead of only understanding links that are
# themselves an image. Read-only, free tier, public files only.
#
# Create at https://console.cloud.google.com — enable the "Google Drive API",
# then Credentials → Create credentials → API key. Restrict it to the Drive API.
#
# Optional: leave unset and Drive links report that they aren't set up. Direct
# image URLs and the generic page-scrape path work without it.
GOOGLE_DRIVE_API_KEY=

# ---- Reporting API (GET /api/v1/clients/leads) ----
# Single shared key for the internal reporting API. Sent as:
#   Authorization: Bearer <key>
# Generate with: openssl rand -base64 32
#
# This key has NO USER BEHIND IT — it can read every client's leads, including
# names, emails and phone numbers. Server-side callers only; the route ships no
# CORS headers so a browser cannot hold it. Rotating it means changing this
# value and redeploying. Unset or under 16 chars = every request 401s.
INTERNAL_API_KEY=

# ---- Stripe ----
# One Stripe account serves every environment. Test mode covers local, preview
# and staging; live mode is production only. A test-mode ID does not resolve in
# live mode or the other way round, so every ID below has a test twin and a live
# twin, and production must be filled in from live mode.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# UNIQUE PER DEPLOYED HOST — the one value that must never be shared between
# environments. Each webhook endpoint in Stripe carries its own signing secret,
# so staging, preview/dev and production each need theirs; reusing one means
# every delivery to the other host fails signature verification with a 400 and
# Stripe retries until it gives up.
#
# Locally this only matters while `stripe listen` is running, which prints a
# secret of its own — different again from any dashboard endpoint. Without the
# CLI, Stripe cannot reach localhost at all and nothing here is ever checked.
STRIPE_WEBHOOK_SECRET=whsec_...

# Subscription plan prices. Same across every pre-production environment.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_AGENCY=price_...
STRIPE_PRICE_SCALE=price_...

# ---- AI overage billing ----
# Reports accrued AI overage to Stripe so it lands on the next invoice at our
# cost + 10%. Optional in the sense that nothing breaks without it —
# reportAiOverageUsage() returns early when the meter event name is unset — but
# an account that enables auto-billing then burns overage up to its spend cap is
# never charged for any of it. Prepaid top-ups and the in-app spend cap work
# either way, so the failure is silent: the product behaves correctly and the
# revenue simply never arrives. Set both values before real users.
#
# Setup, separately in test mode and again in live mode:
#   1. Stripe -> Meters -> create one. Event name as below, aggregation = sum.
#   2. Product -> usage-based price on that meter, $0.01 per unit (1 unit = 1 cent).
#      A flat recurring price here would bill every subscriber monthly and ignore
#      the meter entirely.
# The event name can be the same string in both modes; the price ID cannot.
STRIPE_AI_OVERAGE_METER_EVENT=ai_overage_cents
STRIPE_AI_OVERAGE_PRICE=price_...
