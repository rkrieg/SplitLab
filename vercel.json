{
  "version": 2,
  "framework": "nextjs",
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<host>.*)"
        }
      ],
      "destination": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/utm-detect",
      "schedule": "*/5 * * * *"
    }
  ]
}
